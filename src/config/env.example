# Copy this file to .env and update values for your environment.
# Vite will expose variables prefixed with VITE_ to the client.

# API base URL (backend)
VITE_API_URL=http://localhost:5000/api/v1

# App metadata
VITE_APP_NAME=math-platform
VITE_APP_ENV=development

# Optional: port for dev server (Vite uses 5173 by default)
VITE_DEV_PORT=5173

# Feature toggles
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SSR=false

# NOTE:
# - Do not commit real secrets to source control.
# - For server-only secrets, use a separate server-side env (no VITE_ prefix).
